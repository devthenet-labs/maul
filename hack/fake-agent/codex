#
# The scripted stand-in for the codex CLI, hack/fake-agent/claude's sibling:
# the REAL agent-runner drives it exactly as it drives `codex exec`, so the
# stage flow around the CLI (the harness refusal, the broker provider config,
# the report check, commit.sh, the changeset, the accounting) runs for real.
# The e2e fake kubelet runs it for the Jobs a test asks for (useAgentRunner).
#
# It speaks the parts of codex 0.153.4 agent-runner relies on: `--version`;
# `exec <prompt> --json ... -c key=value ...`, printing the --json events
# (thread.started, turn.started, item.completed, turn.completed with usage).
# Codex has no session to resume and no task output file, so neither exists
# here.
#
# Unlike the scripted claude it reaches a model: every run sends one
# Responses request to the provider its -c overrides configure, as codex
# does, with the placeholder key its env_key names as the bearer and each
# env_http_headers header filled from the variable it names. In e2e that is
# the real egress broker in front of a fake OpenAI upstream, so a test sees
# what the broker attached upstream. A refused request is a turn.failed event
# and exit status 1, as codex reports one.
#
# The intent stages are scripted. A plan (MAUL_PHASE=plan) writes a plan
# naming the repositories the request lists under "## Repositories"; a build
# adds VERSION, commit.sh and its report. The agent evaluator
# (MAUL_PHASE=evaluate) drives the REAL maul-tool from the scratch directory
# it runs in, as hack/fake-agent/claude's does, for every outcome the prompt
# lists: MAUL_FAKE_CODEX_EVALUATE "pass" (default) writes an http check of
# the first component (GET MAUL_FAKE_CLAUDE_CHECK_PATH, default its path, the
# body containing MAUL_FAKE_CLAUDE_CHECK_TEXT, default "ok"), dry-runs it and
# passes the outcome, proposing the check when it ran green; "fail" dry-runs
# it and fails the outcome. The check reviewer (MAUL_PHASE=checkreview)
# answers MAUL_FAKE_CODEX_REVIEW, "proves" by default.
#
# Every invocation appends "<phase> <model> <status>" to $HOME/.fake-codex/calls.
set -eu

if [ "${1:-}" = "--version" ]; then
  echo "codex-cli 0.153.4 (maul scripted stand-in)"
  exit 0
fi

model='' base_url='' env_key='' headers='' prompt=''
if [ "${1:-}" = exec ] && [ $# -ge 2 ]; then
  prompt=$2
  shift 2
fi
while [ $# -gt 0 ]; do
  case "$1" in
  --model) model=$2; shift 2 ;;
  -c)
    case "$2" in
    model_providers.maul.base_url=*) base_url=$(printf '%s' "${2#*=}" | tr -d '"') ;;
    model_providers.maul.env_key=*) env_key=$(printf '%s' "${2#*=}" | tr -d '"') ;;
    model_providers.maul.env_http_headers=*) headers=$(printf '%s' "${2#*=}" | tr -d '{}"') ;;
    esac
    shift 2
    ;;
  *) shift ;;
  esac
done

workspace="${MAUL_WORKSPACE:?MAUL_WORKSPACE is unset}"
state="$HOME/.fake-codex"
mkdir -p "$state"

# The one model request: the bearer is the placeholder key, every header is
# filled from the variable it names. Neither is ever on this command line.
set -- -sS -o "$state/response" -w '%{http_code}' -X POST "$base_url/responses" \
  -H 'Content-Type: application/json'
if [ -n "$env_key" ]; then
  set -- "$@" -H "Authorization: Bearer $(printenv "$env_key" || true)"
fi
for pair in $(printf '%s' "$headers" | tr ',' ' '); do
  set -- "$@" -H "${pair%%=*}: $(printenv "${pair#*=}" || true)"
done
status=$(curl "$@" --data "{\"model\":\"$model\",\"input\":\"scripted ${MAUL_PHASE:-}\",\"max_output_tokens\":1000,\"stream\":false}" || echo 000)
printf '%s %s %s\n' "${MAUL_PHASE:-}" "$model" "$status" >>"$state/calls"

printf '{"type":"thread.started","thread_id":"thread-scripted-%s"}\n' "${MAUL_PHASE:-run}"
printf '{"type":"turn.started"}\n'
if [ "$status" != 200 ]; then
  printf '{"type":"turn.failed","error":{"message":"model request refused with status %s"}}\n' "$status"
  exit 1
fi

# report_path — the report path the prompt names.
# shellcheck disable=SC2016 # the backticks are the prompt's, matched literally
report_path() {
  printf '%s\n' "$prompt" | sed -n 's/.*Write your report to `\([^`]*\)`.*/\1/p' | head -n 1
}

# tool <args> — one maul-tool call: its output in $out, its ledger seq in $seq
# (0 when it printed none). Every command line is appended to $state/tools.
tool() {
  printf '%s\n' "$*" >>"$state/tools"
  out=$(maul-tool "$@" 2>&1) || true
  seq=$(printf '%s\n' "$out" | sed -n 's/^\[maul-tool ledger seq \([0-9]*\)\]$/\1/p' | head -n 1)
  seq=${seq:-0}
}

case "${MAUL_PHASE:-}" in
plan)
  repos=$(sed -n '/^## Repositories/,/^## /p' "$workspace/input/issue.md" | sed -n 's/^- \(https:[^ ]*\).*/  - "\1"/p')
  mkdir -p "$workspace/reports"
  printf '%s\n' '---' 'summary: "Add a VERSION file (scripted plan from hack/fake-agent/codex)"' 'repositories:' \
    "$repos" 'new_dependencies: []' 'questions: []' 'confidence: 0.8' 'estimated_max_turns: 20' \
    'estimated_token_budget: 100000' '---' '' '## Approach' '' 'Add a VERSION file at the repository root.' '' \
    '## Steps' '' '1. Create VERSION.' '' '## Test plan' '' '- go test ./...' '' '## Risks' '' 'None.' \
    >"$workspace/reports/plan.md"
  ;;
build)
  printf '0.1.0\n' >VERSION
  printf '%s\n' '#!/bin/sh' 'set -e' 'git add VERSION' 'git commit -qm "feat: add a VERSION file"' \
    >"$workspace/commit.sh"
  mkdir -p "$workspace/reports"
  printf '%s\n' '---' 'success: true' 'summary: "Add a VERSION file"' 'tests:' '  ran: true' '  passed: true' \
    '  command: "go test ./..."' 'notes: []' '---' '' '## What changed' '' \
    'Scripted build from hack/fake-agent/codex: VERSION names the current version.' \
    >"$workspace/reports/build.md"
  ;;
checkreview)
  out_report=$(report_path)
  answer=${MAUL_FAKE_CODEX_REVIEW:-proves}
  printf '%s\n' '---' "answer: $answer" "reason: \"Scripted review from hack/fake-agent/codex: $answer.\"" '---' \
    >"$out_report"
  ;;
evaluate)
  out_report=$(report_path)
  ids=$(printf '%s\n' "$prompt" | sed -n '/^### The approved outcomes/,/^### The request/s/^[0-9][0-9]*\. \([a-z][a-z0-9-]*\) (a .*)$/\1/p')
  # shellcheck disable=SC2016 # the backticks are the prompt's, matched literally
  key=$(printf '%s\n' "$prompt" | sed -n 's/^- `\([a-z0-9-]*\)`: served under `.*`$/\1/p' | head -n 1)
  # shellcheck disable=SC2016 # the backticks are the prompt's, matched literally
  path=${MAUL_FAKE_CLAUDE_CHECK_PATH:-$(printf '%s\n' "$prompt" | sed -n 's/^- `[a-z0-9-]*`: served under `\(.*\)`$/\1/p' | head -n 1)}
  text=${MAUL_FAKE_CLAUDE_CHECK_TEXT:-ok}
  verdict=${MAUL_FAKE_CODEX_EVALUATE:-pass}
  mkdir -p checks
  tool check results
  verdicts='' proposed=''
  for o in $ids; do
    printf '{"id":"%s","outcome":"%s","form":"http","http":{"target":"%s","steps":[{"request":{"method":"GET","path":"%s"},"expect":{"status":[200],"bodyContains":"%s"}}]}}' \
      "$o" "$o" "$key" "$path" "$text" >"checks/$o.json"
    tool check run "checks/$o.json"
    digest=$(printf '%s\n' "$out" | sed -n 's/^\[observed\] check [^ ]* digest \(sha256:[0-9a-f]*\) dry-run: pass .*/\1/p' | head -n 1)
    verdicts="$verdicts
  - id: $o
    verdict: $verdict
    ledger: [$seq]"
    if [ "$verdict" = pass ] && [ -n "$digest" ]; then
      proposed="$proposed
  - id: \"$o\"
    outcome: $o
    digest: \"$digest\""
    fi
  done
  {
    printf '%s' '---' '
verdicts:' "$verdicts"
    printf '\n%s' 'disputes: []'
    if [ -n "$proposed" ]; then printf '\n%s%s' 'proposed:' "$proposed"; else printf '\n%s' 'proposed: []'; fi
    printf '\n%s\n' 'retire: []' 'anomalies: []' '---' '' "Scripted evaluation ($verdict) from hack/fake-agent/codex."
  } >"$out_report"
  ;;
*)
  printf '{"type":"turn.failed","error":{"message":"the scripted codex only plans, builds, evaluates and reviews checks"}}\n'
  exit 1
  ;;
esac

printf '{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"Report written."}}\n'
printf '{"type":"turn.completed","usage":{"input_tokens":1200,"cached_input_tokens":200,"output_tokens":300}}\n'
