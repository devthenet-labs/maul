#!/bin/sh
# Copyright 2026 Bitwise Media Group Ltd.
# SPDX-License-Identifier: MIT
#
# The scripted stand-in for the claude CLI. Where hack/fake-agent/agent-runner
# replaces agent-runner whole, this replaces only the model: the REAL
# agent-runner drives it exactly as it drives claude, so the stage flow around
# the CLI (the report check, its repair in the same session, the tree guard,
# commit.sh, the changeset, the accounting and the transcript) runs for real.
# The e2e fake kubelet runs it for the Jobs a test asks for (useAgentRunner).
#
# It speaks the parts of the CLI agent-runner relies on, as claude 2.1.291 was
# probed to: `--version`; `-p ... --session-id <id>` starts a session and
# `--resume <id>` continues one, failing with an error result event and exit
# status 1 when the session is unknown; the stream-json events (an init event,
# assistant events with usage, a terminal result event); a resumed run's
# result carries its own num_turns and usage, but a total_cost_usd cumulative
# over the session. Sessions are files under $HOME, as the CLI's are.
#
# The plan and build stages are scripted. A plan (MAUL_PHASE=plan) writes a
# plan naming the repositories the request lists under "## Repositories", as
# hack/fake-agent/codex's does; when its prompt teaches acceptance outcomes
# (the "### Acceptance outcomes" section a verifying Project's plan prompt
# carries) and MAUL_FAKE_PLAN_ACCEPTANCE is
# set (YAML lines), the plan's frontmatter declares that acceptance block, as
# a model asked for them would; a prompt that does not ask gets none. Every
# run's prompt (its standard input, as maul gives the real CLI) is written to
# $HOME/.fake-claude/prompt-<phase> for the test to read. What a build does
# is chosen by the environment, a test's stand-in for a model:
#
#   MAUL_FAKE_CLAUDE_REPORT  the first run's report: "ok" (default), or the
#                              two slips that threw builds away live:
#                              "long-note" (one note of 574 characters, now
#                              accepted rather than refused) and "scalar-notes"
#                              (notes as a single string, still refused).
#   MAUL_FAKE_CLAUDE_REPAIR  what a resumed run does: "fix" (default)
#                              rewrites the report valid, "keep" changes
#                              nothing, "touch" rewrites the report valid and
#                              also edits VERSION, which a repair may not.
#   MAUL_FAKE_CLAUDE_OUTPUT  <n>: the first run also runs a foreground Bash
#                              command printing n lines, as claude 2.1.263 was
#                              probed to: a task_started event, the output
#                              appended line by line to
#                              ${CLAUDE_CODE_TMPDIR:-/tmp}/claude-<uid>/<slug
#                              of the working directory>/<session>/tasks/
#                              <task>.output, the file deleted as the command
#                              ends, then task_notification and the tool
#                              result. Its last line echoes the caller-token
#                              header, which agent-runner must scrub. Unset or
#                              0: no command, as before.
#   MAUL_FAKE_CLAUDE_DELEGATE  set: the first run also hands part of the build
#                              to a subagent with one Agent call, and the CLI
#                              answers it from its argv, as claude 2.1.322 was
#                              probed to: with Agent in --disallowedTools the
#                              call is refused ("No such tool available");
#                              granted (Agent off the deny list, as
#                              agent-runner renders a build granted
#                              subagents), a general-purpose child runs in the
#                              foreground at depth 1 (task_started, two child
#                              calls and their results under the Agent call,
#                              task_notification, the hand-back), and the
#                              result's per-model figures and subagent_stats
#                              count the child's spend, which its top-level
#                              usage does not. "granted" or "refused" is
#                              appended to $HOME/.fake-claude/delegation.
#
# The agent evaluator's stage is scripted too (MAUL_PHASE=evaluate), driving
# the real maul-tool against the round's tool pod:
#
#   MAUL_FAKE_CLAUDE_EVALUATE  what the evaluator does for every outcome the
#                              prompt lists, citing the ledger seqs maul-tool
#                              printed for its own calls ("evaluator
#                              observed": no check is written or proposed):
#                              "pass" (default; "nochecks" is the same) sends
#                              `maul-tool http GET` to MAUL_FAKE_CLAUDE_CHECK_PATH
#                              (default the first component's path) and,
#                              when the answer holds MAUL_FAKE_CLAUDE_CHECK_TEXT
#                              (default "ok"), passes the outcome citing that
#                              call; when it does not, reads the component's
#                              captured log (`maul-tool logs <component>`, the
#                              excerpt a fix round's reproduction quotes) and
#                              fails it, citing the call, with a note; "fail"
#                              sends the same call, reads the log and fails
#                              the outcome on that call whatever it showed;
#                              "cite-logs" reads the log and passes every
#                              outcome citing only that read and a seq the
#                              ledger does not hold, neither of which maul
#                              counts; "browser" opens
#                              MAUL_FAKE_CLAUDE_BROWSER_ENTRY (default /),
#                              takes a snapshot, clicks the first element
#                              after the root, takes a screenshot, then
#                              measures the element of test id
#                              MAUL_FAKE_CLAUDE_BROWSER_TESTID (default vote)
#                              with its own page script (`browser eval`):
#                              a MAUL_FAKE_CLAUDE_BROWSER_SIZE (default 32) px
#                              square passes the outcome citing the
#                              screenshot and the script, anything else fails
#                              it citing the script; "browser-look" opens the
#                              entry, takes a snapshot and a screenshot, and
#                              passes every outcome on the screenshot.
#                              On a Project with no preview (the workspace
#                              prompt): "cli-pass" runs the built program
#                              (the path the prompt names) with
#                              MAUL_FAKE_CLAUDE_CLI_ARGS (space-separated,
#                              default --help) at the head and, as context,
#                              with --base, and passes the outcome citing the
#                              head run when its output holds
#                              MAUL_FAKE_CLAUDE_CHECK_TEXT, else fails it
#                              citing it; "cli-fail" runs it at the head and,
#                              when the output lacks the text, fails the
#                              outcome citing the run, else is unsure;
#                              "base-cite" runs it with --base alone and
#                              passes the outcome citing that base run,
#                              which maul never counts; "lib-newsymbol" reads
#                              the tree's go.mod (files read), runs a Go
#                              program referring to the library's
#                              MAUL_FAKE_CLAUDE_SYMBOL (default ErrTooLong; of
#                              package MAUL_FAKE_CLAUDE_PACKAGE under the
#                              module, default its root) at the head and with
#                              --base (where a new symbol does not compile),
#                              and passes the outcome citing the read and the
#                              head run when the program printed "explore
#                              found" there, else is unsure.
#   MAUL_FAKE_CLAUDE_ANOMALY   set: the report also carries one look-around
#                              anomaly with this summary, on the first
#                              component's path, citing the first call the
#                              evaluator made to the change.
#   MAUL_FAKE_CLAUDE_CAPPED    set: the evaluator runs out of turns, as every
#                              live evaluator of S1 bug 3 did: its first run
#                              makes every call above but, instead of writing
#                              its report, ends on claude's error_max_turns
#                              result (exit status 1), and the resumed run
#                              maul then asks for its report writes the report
#                              the first run would have.
#
# A resumed evaluate run (a repair) otherwise keeps the report as it was.
#
# Every invocation appends "<first|resume> <session> <max-turns>
# <allowedTools>" to $HOME/.fake-claude/calls for the test to read.
set -eu

if [ "${1:-}" = "--version" ]; then
  echo "2.1.291 (Claude Code; maul scripted stand-in)"
  exit 0
fi

mode='' session='' turns='' tools='' denied='' prompt=''
while [ $# -gt 0 ]; do
  case "$1" in
  --session-id) mode=first session=$2; shift 2 ;;
  --resume) mode=resume session=$2; shift 2 ;;
  --max-turns) turns=$2; shift 2 ;;
  --allowedTools) tools=$2; shift 2 ;;
  --disallowedTools) denied=$2; shift 2 ;;
  -p) shift ;;
  --model | --output-format | --tools | --setting-sources | --permission-mode | --add-dir | \
    --append-system-prompt | --settings) shift 2 ;;
  *) shift ;;
  esac
done

workspace="${MAUL_WORKSPACE:?MAUL_WORKSPACE is unset}"
state="$HOME/.fake-claude"
mkdir -p "$state/sessions"
printf '%s %s %s %s\n' "$mode" "$session" "$turns" "$tools" >>"$state/calls"
# The prompt is the standard input, recorded byte for byte.
cat >"$state/prompt-${MAUL_PHASE:-none}"
prompt=$(cat "$state/prompt-${MAUL_PHASE:-none}")

case "${MAUL_PHASE:-}" in
plan | build | evaluate) ;;
*) mode='' ;;
esac
if [ -z "$mode" ]; then
  printf '{"type":"result","subtype":"error_during_execution","is_error":true,"num_turns":0,"session_id":"%s","errors":["the scripted claude only plans, builds and evaluates"]}\n' "$session"
  exit 1
fi

report="$workspace/reports/build.md"
mkdir -p "$workspace/reports"

# write_report <notes line> — the build report, with the notes line given.
write_report() {
  printf '%s\n' '---' 'success: true' 'summary: "Add a VERSION file"' 'tests:' '  ran: true' \
    '  passed: true' '  command: "go test ./..."' "$1" '---' '' '## What changed' '' \
    'Scripted build from hack/fake-agent/claude: VERSION names the current version.' '' \
    '## Working notes' '' '- VERSION sits at the repository root; nothing reads it yet.' >"$report"
}

# init <session> — the session's init event, printed once per run.
inited=''
init() {
  [ -z "$inited" ] || return 0
  printf '{"type":"system","subtype":"init","session_id":"%s"}\n' "$1"
  inited=1
}

# run_command <session> <lines> — a foreground Bash command printing that many
# lines, its output written to the file the CLI keeps it in while it runs.
run_command() {
  init "$1"
  task=bscripted1 call=toolu_scripted1
  printf '{"type":"assistant","message":{"id":"msg_cmd","content":[{"type":"tool_use","id":"%s","name":"Bash","input":{"command":"go test ./..."}}]}}\n' \
    "$call"
  dir="${CLAUDE_CODE_TMPDIR:-/tmp}/claude-$(id -u)/$(pwd | tr '/.' '--')/$1/tasks"
  mkdir -p "$dir"
  file="$dir/$task.output"
  : >"$file"
  printf '{"type":"system","subtype":"task_started","task_id":"%s","tool_use_id":"%s","description":"Run the suite","task_type":"local_bash","is_backgrounded":false,"uuid":"u-%s","session_id":"%s"}\n' \
    "$task" "$call" "$task" "$1"
  i=1
  while [ "$i" -le "$2" ]; do
    printf 'ok  example.com/app/pkg%d\n' "$i" >>"$file"
    sleep 0.02
    i=$((i + 1))
  done
  printf 'header: %s\n' "${ANTHROPIC_CUSTOM_HEADERS:-none}" >>"$file"
  rm -f "$file"
  printf '{"type":"system","subtype":"task_notification","task_id":"%s","tool_use_id":"%s","status":"completed","output_file":"","session_id":"%s"}\n' \
    "$task" "$call" "$1"
  printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"%s","content":"ok  %s packages"}]}}\n' \
    "$call" "$2"
}

# emit <session> <turns> <in> <cache write> <cache read> <out> <cost> <text>
# [<result fields>] — the last argument, when given, is appended to the
# result event's members (a leading comma included).
emit() {
  init "$1"
  printf '{"type":"assistant","message":{"id":"msg_%s_%s","usage":{"input_tokens":%s,"cache_creation_input_tokens":%s,"cache_read_input_tokens":%s,"output_tokens":%s},"content":[{"type":"text","text":"%s"}]}}\n' \
    "$mode" "$2" "$3" "$4" "$5" "$6" "$8"
  printf '{"type":"result","subtype":"success","is_error":false,"result":"%s","session_id":"%s","num_turns":%s,"total_cost_usd":%s,"usage":{"input_tokens":%s,"cache_creation_input_tokens":%s,"cache_read_input_tokens":%s,"output_tokens":%s}%s}\n' \
    "$8" "$1" "$2" "$7" "$3" "$4" "$5" "$6" "${9:-}"
}

# model_usage <in> <cache write> <cache read> <out> — a result's per-model
# figures for the one model the scripted run calls.
model_usage() {
  printf '{"claude-scripted":{"inputTokens":%s,"cacheCreationInputTokens":%s,"cacheReadInputTokens":%s,"outputTokens":%s}}' \
    "$1" "$2" "$3" "$4"
}

# delegate <session> — the parent's Agent call, answered as the CLI answers
# it under the argv given (see MAUL_FAKE_CLAUDE_DELEGATE). A granted child
# makes two calls, spending 2000 input, 100 cache write, 50000 cache read
# and 600 output tokens; it writes nothing.
delegated=''
delegate() {
  init "$1"
  call=toolu_delegate task=adelegate1
  printf '{"type":"assistant","message":{"id":"msg_delegate","usage":{"input_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":1},"content":[{"type":"tool_use","id":"%s","name":"Agent","input":{"description":"Run the suite","prompt":"Run go test ./... and report what fails.","subagent_type":"general-purpose"}}]},"parent_tool_use_id":null,"session_id":"%s"}\n' \
    "$call" "$1"
  case " $denied " in
  *" Agent "*)
    printf '%s\n' refused >>"$state/delegation"
    printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"<tool_use_error>Error: No such tool available: Agent. Agent is disabled for this session, in subagents as well as here.</tool_use_error>","is_error":true,"tool_use_id":"%s"}]},"parent_tool_use_id":null,"session_id":"%s"}\n' \
      "$call" "$1"
    return 0
    ;;
  esac
  printf '%s\n' granted >>"$state/delegation"
  delegated=1
  printf '{"type":"system","subtype":"task_started","task_id":"%s","tool_use_id":"%s","description":"Run the suite","subagent_type":"general-purpose","is_backgrounded":false,"spawn_depth":1,"task_type":"local_agent","prompt":"Run go test ./... and report what fails.","uuid":"u-%s","session_id":"%s"}\n' \
    "$task" "$call" "$task" "$1"
  printf '{"type":"user","message":{"role":"user","content":[{"type":"text","text":"Run go test ./... and report what fails."}]},"parent_tool_use_id":"%s","agent_id":"%s","session_id":"%s"}\n' \
    "$call" "$task" "$1"
  printf '{"type":"assistant","message":{"id":"msg_child_1","usage":{"input_tokens":1000,"cache_creation_input_tokens":100,"cache_read_input_tokens":25000,"output_tokens":1},"content":[{"type":"tool_use","id":"toolu_child_1","name":"Bash","input":{"command":"go test ./..."}}]},"parent_tool_use_id":"%s","agent_id":"%s","session_id":"%s"}\n' \
    "$call" "$task" "$1"
  printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_child_1","content":"ok  example.com/app","is_error":false}]},"parent_tool_use_id":"%s","agent_id":"%s","session_id":"%s"}\n' \
    "$call" "$task" "$1"
  printf '{"type":"assistant","message":{"id":"msg_child_2","usage":{"input_tokens":1000,"cache_creation_input_tokens":0,"cache_read_input_tokens":25000,"output_tokens":1},"content":[{"type":"tool_use","id":"toolu_child_2","name":"Read","input":{"file_path":"VERSION"}}]},"parent_tool_use_id":"%s","agent_id":"%s","session_id":"%s"}\n' \
    "$call" "$task" "$1"
  printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"toolu_child_2","content":"0.1.0"}]},"parent_tool_use_id":"%s","agent_id":"%s","session_id":"%s"}\n' \
    "$call" "$task" "$1"
  printf '{"type":"system","subtype":"task_notification","task_id":"%s","tool_use_id":"%s","status":"completed","output_file":"","summary":"The suite passes.","usage":{"total_tokens":52700,"tool_uses":2,"duration_ms":40},"session_id":"%s"}\n' \
    "$task" "$call" "$1"
  printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"%s","content":[{"type":"text","text":"The suite passes."}]}]},"parent_tool_use_id":null,"session_id":"%s"}\n' \
    "$call" "$1"
}

# --- The evaluator's stage -------------------------------------------------
#
# It writes its report where the prompt says ("Write your report to
# `<path>`"). The evaluator drives the REAL maul-tool against the round's tool
# pod (MAUL_TOOLS_URL), from the scratch directory it runs in, as a model
# following the evaluate prompt would: per mode (MAUL_FAKE_CLAUDE_EVALUATE)
# calls to the change, and a report whose verdicts cite the ledger seqs
# maul-tool printed. Every maul-tool command line is appended to
# $HOME/.fake-claude/tools.

# report_path — the report path the prompt names.
# shellcheck disable=SC2016 # the backticks are the prompt's, matched literally
report_path() {
  printf '%s\n' "$prompt" | sed -n 's/.*Write your report to `\([^`]*\)`.*/\1/p' | head -n 1
}

# tool <args> — one maul-tool call: its output in $out, its ledger seq in $seq
# (0 when it printed none). A refusal or a tool error is the tool's answer,
# never the script's failure.
tool() {
  printf '%s\n' "$*" >>"$state/tools"
  out=$(maul-tool "$@" 2>&1) || true
  seq=$(printf '%s\n' "$out" | sed -n 's/^\[maul-tool ledger seq \([0-9]*\)\]$/\1/p' | head -n 1)
  seq=${seq:-0}
}

# shows <text> — the last call's output holds text.
shows() {
  printf '%s\n' "$out" | grep -qF -- "$1"
}

# library_program <import path> <symbol> — a Go program that refers to the
# library's symbol, so it compiles only where the symbol exists, and prints
# "<its first argument> found".
library_program() {
  printf 'package main\n\nimport (\n    "fmt"\n    "os"\n\n    lib "%s"\n)\n\nvar _ = lib.%s\n\n' "$1" "$2"
  printf 'func main() { fmt.Println(os.Args[1], "found") }\n'
}

if [ "$MAUL_PHASE" = evaluate ]; then
  if [ "$mode" = resume ]; then
    # A repair: the report is rewritten exactly as the first run wrote it,
    # or, after a capped run, written from what that run found.
    if [ -f "$state/capped-report" ]; then
      mv "$state/capped-report" "$(cat "$state/capped-path")"
    fi
    cost=$(($(cat "$state/sessions/$session" 2>/dev/null || echo 0) + 100))
    echo "$cost" >"$state/sessions/$session"
    emit "$session" 1 10 20 3000 30 "$(printf '0.%04d' "$cost")" "Report kept."
    exit 0
  fi
  out_report=$(report_path)
  ids=$(printf '%s\n' "$prompt" | sed -n '/^### The approved outcomes/,/^### The request/s/^[0-9][0-9]*\. \([a-z][a-z0-9-]*\) (a .*)$/\1/p')
  # shellcheck disable=SC2016 # the backticks are the prompt's, matched literally
  key=$(printf '%s\n' "$prompt" | sed -n 's/^- `\([a-z0-9-]*\)`: served under `.*`$/\1/p' | head -n 1)
  # shellcheck disable=SC2016 # the backticks are the prompt's, matched literally
  path=${MAUL_FAKE_CLAUDE_CHECK_PATH:-$(printf '%s\n' "$prompt" | sed -n 's/^- `[a-z0-9-]*`: served under `\(.*\)`$/\1/p' | head -n 1)}
  text=${MAUL_FAKE_CLAUDE_CHECK_TEXT:-ok}
  # shellcheck disable=SC2016 # the backticks are the prompt's, matched literally
  bin=$(printf '%s\n' "$prompt" | sed -n 's/.*which writes the program to `\([^`]*\)`:$/\1/p' | head -n 1)
  entry=${MAUL_FAKE_CLAUDE_BROWSER_ENTRY:-/}
  testid=${MAUL_FAKE_CLAUDE_BROWSER_TESTID:-vote}
  size=${MAUL_FAKE_CLAUDE_BROWSER_SIZE:-32}
  verdicts='' first=0
  for o in $ids; do
    case "${MAUL_FAKE_CLAUDE_EVALUATE:-pass}" in
    pass | nochecks)
      # The report as the live evaluators write it (S1 bug 5): each verdict
      # names its outcome as outcome.
      tool http GET "$path"
      seen=$seq
      [ "$first" != 0 ] || first=$seen
      if shows "$text"; then
        verdicts="$verdicts
  - outcome: $o
    verdict: pass
    ledger: [$seen]"
      else
        tool logs "$key"
        verdicts="$verdicts
  - outcome: $o
    verdict: fail
    ledger: [$seen]
    note: \"The page does not show what the outcome states.\""
      fi
      ;;
    fail)
      tool http GET "$path"
      seen=$seq
      [ "$first" != 0 ] || first=$seen
      tool logs "$key"
      verdicts="$verdicts
  - id: $o
    verdict: fail
    ledger: [$seen]
    note: \"The page does not show what the outcome states.\""
      ;;
    cite-logs)
      tool logs "$key"
      verdicts="$verdicts
  - id: $o
    verdict: pass
    ledger: [$seq, 9999]
    note: \"The log says it works.\""
      ;;
    browser)
      tool browser goto "$entry"
      tool browser snapshot
      ref=$(printf '%s\n' "$out" | sed -n 's/.* \[ref=\(e[0-9]*\)\].*/\1/p' | sed -n 2p)
      tool browser click "${ref:-e2}"
      tool browser screenshot
      shot=$seq
      [ "$first" != 0 ] || first=$shot
      tool browser eval "() => { const r = document.querySelector('[data-testid=\"$testid\"]').getBoundingClientRect(); return { width: r.width, height: r.height }; }"
      measured=$seq
      if shows "{\"width\":$size,\"height\":$size}"; then
        verdicts="$verdicts
  - id: $o
    verdict: pass
    ledger: [$shot, $measured]"
      else
        verdicts="$verdicts
  - id: $o
    verdict: fail
    ledger: [$measured]
    note: \"The $testid button is not a $size px square.\""
      fi
      ;;
    browser-look)
      tool browser goto "$entry"
      tool browser snapshot
      tool browser screenshot
      [ "$first" != 0 ] || first=$seq
      verdicts="$verdicts
  - id: $o
    verdict: pass
    ledger: [$seq]
    note: \"The screenshot shows what the outcome states.\""
      ;;
    cli-pass)
      # shellcheck disable=SC2086 # the args are split as given
      tool exec -- "$bin" ${MAUL_FAKE_CLAUDE_CLI_ARGS:---help}
      head=$seq
      [ "$first" != 0 ] || first=$head
      held=''
      shows "$text" && held=1
      # shellcheck disable=SC2086 # the args are split as given
      tool exec --base -- "$bin" ${MAUL_FAKE_CLAUDE_CLI_ARGS:---help}
      if [ -n "$held" ]; then
        verdicts="$verdicts
  - outcome: $o
    verdict: pass
    ledger: [$head]"
      else
        verdicts="$verdicts
  - outcome: $o
    verdict: fail
    ledger: [$head]
    note: \"The program does not print what the outcome states.\""
      fi
      ;;
    cli-fail)
      # shellcheck disable=SC2086 # the args are split as given
      tool exec -- "$bin" ${MAUL_FAKE_CLAUDE_CLI_ARGS:---help}
      [ "$first" != 0 ] || first=$seq
      if shows "$text"; then
        verdicts="$verdicts
  - outcome: $o
    verdict: unsure
    ledger: [$seq]"
      else
        verdicts="$verdicts
  - outcome: $o
    verdict: fail
    ledger: [$seq]
    note: \"The program does not print what the outcome states.\""
      fi
      ;;
    base-cite)
      # shellcheck disable=SC2086 # the args are split as given
      tool exec --base -- "$bin" ${MAUL_FAKE_CLAUDE_CLI_ARGS:---help}
      verdicts="$verdicts
  - outcome: $o
    verdict: pass
    ledger: [$seq]
    note: \"The commit the branch started from already does it.\""
      ;;
    lib-newsymbol)
      tool files read go.mod
      read_mod=$seq
      module=$(printf '%s\n' "$out" | sed -n 's/^module \([^ ]*\).*/\1/p' | head -n 1)
      import=$module${MAUL_FAKE_CLAUDE_PACKAGE:+/$MAUL_FAKE_CLAUDE_PACKAGE}
      mkdir -p "prog-$o"
      library_program "$import" "${MAUL_FAKE_CLAUDE_SYMBOL:-ErrTooLong}" >"prog-$o/main.go"
      tool run "prog-$o" -- explore
      explored=$seq
      [ "$first" != 0 ] || first=$explored
      found=''
      shows "explore found" && found=1
      tool run "prog-$o" --base -- explore
      if [ -n "$found" ]; then
        verdicts="$verdicts
  - outcome: $o
    verdict: pass
    ledger: [$read_mod, $explored]
    note: \"The symbol is new: the base does not compile against it.\""
      else
        verdicts="$verdicts
  - outcome: $o
    verdict: unsure
    ledger: [$explored]"
      fi
      ;;
    esac
  done
  {
    printf '%s' '---' '
verdicts:' "$verdicts"
    if [ -n "${MAUL_FAKE_CLAUDE_ANOMALY:-}" ]; then
      printf '\n%s\n' 'anomalies:' "  - summary: \"$MAUL_FAKE_CLAUDE_ANOMALY\"" "    route: \"$path\"" \
        "    ledger: [$first]"
    else
      printf '\n%s\n' 'anomalies: []'
    fi
    printf '%s\n' '---' '' "Scripted evaluation (${MAUL_FAKE_CLAUDE_EVALUATE:-pass}) from hack/fake-agent/claude."
  } >"$state/report"
  echo 800 >"$state/sessions/$session"
  if [ -n "${MAUL_FAKE_CLAUDE_CAPPED:-}" ]; then
    mv "$state/report" "$state/capped-report"
    printf '%s' "$out_report" >"$state/capped-path"
    init "$session"
    printf '{"type":"result","subtype":"error_max_turns","is_error":true,"result":"","session_id":"%s","num_turns":%s,"total_cost_usd":0.0800,"usage":{"input_tokens":2000,"cache_creation_input_tokens":300,"cache_read_input_tokens":4000,"output_tokens":600},"errors":["Reached maximum number of turns (%s)"]}\n' \
      "$session" "$turns" "$turns"
    exit 1
  fi
  mv "$state/report" "$out_report"
  emit "$session" 6 2000 300 4000 600 0.0800 "Evaluated: ${MAUL_FAKE_CLAUDE_EVALUATE:-pass}."
  exit 0
fi

if [ "$MAUL_PHASE" = plan ]; then
  repos=$(sed -n '/^## Repositories/,/^## /p' "$workspace/input/issue.md" | sed -n 's/^- \(https:[^ ]*\).*/  - "\1"/p')
  acceptance=''
  case "$prompt" in
  *'### Acceptance outcomes'*) acceptance=${MAUL_FAKE_PLAN_ACCEPTANCE:-} ;;
  esac
  mkdir -p "$workspace/reports"
  {
    printf '%s\n' '---' 'summary: "Add a VERSION file (scripted plan from hack/fake-agent/claude)"' 'repositories:'
    [ -z "$repos" ] || printf '%s\n' "$repos"
    printf '%s\n' 'new_dependencies: []' 'questions: []' 'confidence: 0.8' 'estimated_max_turns: 20' \
      'estimated_token_budget: 100000'
    [ -z "$acceptance" ] || printf '%s\n' "$acceptance"
    printf '%s\n' '---' '' '## Approach' '' 'Add a VERSION file at the repository root.' '' '## Steps' '' \
      '1. Create VERSION.' '' '## Test plan' '' '- go test ./...' '' '## Risks' '' 'None.'
  } >"$workspace/reports/plan.md"
  echo 500 >"$state/sessions/$session"
  emit "$session" 2 800 100 2000 300 0.0500 "Planned: add a VERSION file."
  exit 0
fi

if [ "$mode" = first ]; then
  printf '0.1.0\n' >VERSION
  printf '%s\n' '#!/bin/sh' 'set -e' 'git add VERSION' 'git commit -qm "feat: add a VERSION file"' \
    >"$workspace/commit.sh"
  case "${MAUL_FAKE_CLAUDE_REPORT:-ok}" in
  long-note) write_report "notes:
  - \"$(printf '%574s' '' | tr ' ' 'n')\"" ;;
  scalar-notes) write_report 'notes: "What was built: a VERSION file at the repository root"' ;;
  *) write_report 'notes: []' ;;
  esac
  [ "${MAUL_FAKE_CLAUDE_OUTPUT:-0}" -eq 0 ] || run_command "$session" "$MAUL_FAKE_CLAUDE_OUTPUT"
  [ -z "${MAUL_FAKE_CLAUDE_DELEGATE:-}" ] || delegate "$session"
  if [ -n "$delegated" ]; then
    # The parent's 1000/200/3000/400 and the child's 2000/100/50000/600, in
    # the per-model figures alone; the top-level usage stays the parent's.
    echo 3000 >"$state/sessions/$session"
    figures=$(model_usage 3000 300 53000 1000)
    emit "$session" 3 1000 200 3000 400 0.3000 "Built: VERSION added, the suite passes." \
      ",\"modelUsage\":$figures,\"model_usage_since_last_result\":$figures,\"subagent_stats\":{\"spawned\":1,\"max_depth\":1,\"completed\":1}"
    exit 0
  fi
  # Cost in hundredths of a cent, cumulative over the session, as the CLI's.
  echo 1000 >"$state/sessions/$session"
  emit "$session" 3 1000 200 3000 400 0.1000 "Built: VERSION added, the suite passes."
  exit 0
fi

if [ ! -f "$state/sessions/$session" ]; then
  printf '{"type":"result","subtype":"error_during_execution","is_error":true,"num_turns":0,"session_id":"%s","total_cost_usd":0,"usage":{"input_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":0},"errors":["No conversation found with session ID: %s"]}\n' \
    "$session" "$session"
  echo "No conversation found with session ID: $session" >&2
  exit 1
fi

case "${MAUL_FAKE_CLAUDE_REPAIR:-fix}" in
fix) write_report 'notes: []' ;;
touch)
  write_report 'notes: []'
  printf '0.2.0\n' >VERSION
  ;;
esac
cost=$(($(cat "$state/sessions/$session") + 100))
echo "$cost" >"$state/sessions/$session"
emit "$session" 1 10 20 3000 30 "$(printf '0.%04d' "$cost")" "Report fixed."
