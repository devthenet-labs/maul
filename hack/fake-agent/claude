#!/bin/sh
# Copyright 2026 Bitwise Media Group Ltd.
# SPDX-License-Identifier: MIT
#
# The scripted stand-in for the claude CLI. Where hack/fake-agent/agent-runner
# replaces agent-runner whole, this replaces only the model: the REAL
# agent-runner drives it exactly as it drives claude, so the stage flow around
# the CLI (the report check, its repair in the same session, the tree guard,
# commit.sh, the changeset, the accounting and the transcript) runs for real.
# The e2e fake kubelet runs it for the Jobs a test asks for (useAgentRunner).
#
# It speaks the parts of the CLI agent-runner relies on, as claude 2.1.291 was
# probed to: `--version`; `-p ... --session-id <id>` starts a session and
# `--resume <id>` continues one, failing with an error result event and exit
# status 1 when the session is unknown; the stream-json events (an init event,
# assistant events with usage, a terminal result event); a resumed run's
# result carries its own num_turns and usage, but a total_cost_usd cumulative
# over the session. Sessions are files under $HOME, as the CLI's are.
#
# The plan and build stages are scripted. A plan (MAUL_PHASE=plan) writes a
# plan naming the repositories the request lists under "## Repositories", as
# hack/fake-agent/codex's does; when its prompt teaches acceptance criteria
# (the "### Acceptance criteria" section a verifying Project's plan prompt
# carries) and MAUL_FAKE_PLAN_ACCEPTANCE is set (YAML lines), the plan's
# frontmatter declares that acceptance block, as a model asked for criteria
# would; a prompt that does not ask gets none. Every run's prompt (the -p
# argument) is written to $HOME/.fake-claude/prompt-<phase> for the test to
# read. What a build does is chosen by the environment, a test's stand-in
# for a model:
#
#   MAUL_FAKE_CLAUDE_REPORT  the first run's report: "ok" (default), or the
#                              two slips that threw builds away live:
#                              "long-note" (one note of 574 characters, now
#                              accepted rather than refused) and "scalar-notes"
#                              (notes as a single string, still refused).
#   MAUL_FAKE_CLAUDE_REPAIR  what a resumed run does: "fix" (default)
#                              rewrites the report valid, "keep" changes
#                              nothing, "touch" rewrites the report valid and
#                              also edits VERSION, which a repair may not.
#   MAUL_FAKE_CLAUDE_OUTPUT  <n>: the first run also runs a foreground Bash
#                              command printing n lines, as claude 2.1.263 was
#                              probed to: a task_started event, the output
#                              appended line by line to
#                              ${CLAUDE_CODE_TMPDIR:-/tmp}/claude-<uid>/<slug
#                              of the working directory>/<session>/tasks/
#                              <task>.output, the file deleted as the command
#                              ends, then task_notification and the tool
#                              result. Its last line echoes the caller-token
#                              header, which agent-runner must scrub. Unset or
#                              0: no command, as before.
#
# The agent evaluator's and the check reviewer's stages are scripted too
# (MAUL_PHASE=evaluate, checkreview), the evaluator driving the real
# maul-tool against the round's tool pod:
#
#   MAUL_FAKE_CLAUDE_EVALUATE  what the evaluator does for every outcome the
#                              prompt lists, after `maul-tool check results`:
#                              "pass" (default) writes an http check of the
#                              first component (GET MAUL_FAKE_CLAUDE_CHECK_PATH,
#                              default that component's path, its body
#                              containing MAUL_FAKE_CLAUDE_CHECK_TEXT, default
#                              "ok"), dry-runs it, and passes the outcome on
#                              that run, proposing the check when it ran
#                              green; "fail" dry-runs the same check, reads
#                              the component's captured log after it
#                              (`maul-tool logs <component>`, the excerpt a
#                              fix round's reproduction quotes) and fails
#                              the outcome on that run, proposing nothing; "red"
#                              judges as a careful evaluator does (S1 bug 7):
#                              it dry-runs the same check and, green, passes
#                              the outcome and proposes it as "pass" does;
#                              red by assertion (maul-tool's "red by assertion"
#                              line), reads the component's log, fails the
#                              outcome on that run and proposes the check with
#                              expect: fail; red any other way, unsure; "dispute"
#                              disputes the first saved check `check results`
#                              shows failing its replay, proposing a green
#                              replacement (<outcome>.r), the outcome unsure;
#                              "canary" does what an injected page asks:
#                              writes a vacuous check (a status alone), which
#                              the dry run refuses, proposes it anyway by its
#                              own digest and passes every outcome; and
#                              "nochecks" passes every outcome on one
#                              `maul-tool http GET` and proposes nothing;
#                              "browser" opens MAUL_FAKE_CLAUDE_BROWSER_ENTRY
#                              (default /) in the browser, takes a snapshot,
#                              clicks the first element after the root, takes
#                              a screenshot, then writes and dry-runs a
#                              browser check measuring the element of test id
#                              MAUL_FAKE_CLAUDE_BROWSER_TESTID (default vote):
#                              visible, a MAUL_FAKE_CLAUDE_BROWSER_SIZE
#                              (default 32) px square, clickable; passing the
#                              outcome and proposing the check when it ran
#                              green, else failing it, citing the screenshot
#                              and the run; "browser-look" opens the entry,
#                              takes a snapshot and a screenshot, and passes
#                              every outcome on the screenshot alone,
#                              proposing nothing.
#   MAUL_FAKE_CLAUDE_ANOMALY   set: the report also carries one look-around
#                              anomaly with this summary, on the first
#                              component's path, citing `check results`.
#   MAUL_FAKE_CLAUDE_REVIEW    the check reviewer's answer for every check:
#                              "proves" (default), "does_not_prove" or
#                              "unclear".
#   MAUL_FAKE_CLAUDE_CAPPED    set: the evaluator runs out of turns, as every
#                              live evaluator of S1 bug 3 did: its first run
#                              makes every call above but, instead of writing
#                              its report, ends on claude's error_max_turns
#                              result (exit status 1), and the resumed run
#                              maul then asks for its report writes the report
#                              the first run would have.
#
# A resumed evaluate run (a repair) otherwise keeps the report as it was.
#
# Every invocation appends "<first|resume> <session> <max-turns>
# <allowedTools>" to $HOME/.fake-claude/calls for the test to read.
set -eu

if [ "${1:-}" = "--version" ]; then
  echo "2.1.291 (Claude Code; maul scripted stand-in)"
  exit 0
fi

mode='' session='' turns='' tools='' prompt=''
while [ $# -gt 0 ]; do
  case "$1" in
  --session-id) mode=first session=$2; shift 2 ;;
  --resume) mode=resume session=$2; shift 2 ;;
  --max-turns) turns=$2; shift 2 ;;
  --allowedTools) tools=$2; shift 2 ;;
  -p) prompt=$2; shift 2 ;;
  --model | --output-format | --tools | --disallowedTools | --setting-sources | --permission-mode | --add-dir | \
    --append-system-prompt) shift 2 ;;
  *) shift ;;
  esac
done

workspace="${MAUL_WORKSPACE:?MAUL_WORKSPACE is unset}"
state="$HOME/.fake-claude"
mkdir -p "$state/sessions"
printf '%s %s %s %s\n' "$mode" "$session" "$turns" "$tools" >>"$state/calls"
printf '%s' "$prompt" >"$state/prompt-${MAUL_PHASE:-none}"

case "${MAUL_PHASE:-}" in
plan | build | evaluate | checkreview) ;;
*) mode='' ;;
esac
if [ -z "$mode" ]; then
  printf '{"type":"result","subtype":"error_during_execution","is_error":true,"num_turns":0,"session_id":"%s","errors":["the scripted claude only plans, builds, evaluates and reviews checks"]}\n' "$session"
  exit 1
fi

report="$workspace/reports/build.md"
mkdir -p "$workspace/reports"

# write_report <notes line> — the build report, with the notes line given.
write_report() {
  printf '%s\n' '---' 'success: true' 'summary: "Add a VERSION file"' 'tests:' '  ran: true' \
    '  passed: true' '  command: "go test ./..."' "$1" '---' '' '## What changed' '' \
    'Scripted build from hack/fake-agent/claude: VERSION names the current version.' '' \
    '## Working notes' '' '- VERSION sits at the repository root; nothing reads it yet.' >"$report"
}

# init <session> — the session's init event, printed once per run.
inited=''
init() {
  [ -z "$inited" ] || return 0
  printf '{"type":"system","subtype":"init","session_id":"%s"}\n' "$1"
  inited=1
}

# run_command <session> <lines> — a foreground Bash command printing that many
# lines, its output written to the file the CLI keeps it in while it runs.
run_command() {
  init "$1"
  task=bscripted1 call=toolu_scripted1
  printf '{"type":"assistant","message":{"id":"msg_cmd","content":[{"type":"tool_use","id":"%s","name":"Bash","input":{"command":"go test ./..."}}]}}\n' \
    "$call"
  dir="${CLAUDE_CODE_TMPDIR:-/tmp}/claude-$(id -u)/$(pwd | tr '/.' '--')/$1/tasks"
  mkdir -p "$dir"
  file="$dir/$task.output"
  : >"$file"
  printf '{"type":"system","subtype":"task_started","task_id":"%s","tool_use_id":"%s","description":"Run the suite","task_type":"local_bash","is_backgrounded":false,"uuid":"u-%s","session_id":"%s"}\n' \
    "$task" "$call" "$task" "$1"
  i=1
  while [ "$i" -le "$2" ]; do
    printf 'ok  example.com/app/pkg%d\n' "$i" >>"$file"
    sleep 0.02
    i=$((i + 1))
  done
  printf 'header: %s\n' "${ANTHROPIC_CUSTOM_HEADERS:-none}" >>"$file"
  rm -f "$file"
  printf '{"type":"system","subtype":"task_notification","task_id":"%s","tool_use_id":"%s","status":"completed","output_file":"","session_id":"%s"}\n' \
    "$task" "$call" "$1"
  printf '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","tool_use_id":"%s","content":"ok  %s packages"}]}}\n' \
    "$call" "$2"
}

# emit <session> <turns> <in> <cache write> <cache read> <out> <cost> <text>
emit() {
  init "$1"
  printf '{"type":"assistant","message":{"id":"msg_%s_%s","usage":{"input_tokens":%s,"cache_creation_input_tokens":%s,"cache_read_input_tokens":%s,"output_tokens":%s},"content":[{"type":"text","text":"%s"}]}}\n' \
    "$mode" "$2" "$3" "$4" "$5" "$6" "$8"
  printf '{"type":"result","subtype":"success","is_error":false,"result":"%s","session_id":"%s","num_turns":%s,"total_cost_usd":%s,"usage":{"input_tokens":%s,"cache_creation_input_tokens":%s,"cache_read_input_tokens":%s,"output_tokens":%s}}\n' \
    "$8" "$1" "$2" "$7" "$3" "$4" "$5" "$6"
}

# --- The evaluator's and the check reviewer's stages -----------------------
#
# Both write their report where the prompt says ("Write your report to
# `<path>`"). The evaluator drives the REAL maul-tool against the round's tool
# pod (MAUL_TOOLS_URL), from the scratch directory it runs in, as a model
# following the evaluate prompt would: `check results` first, then per mode
# (MAUL_FAKE_CLAUDE_EVALUATE) checks written with "Write" (a file under
# checks/), dry-run with `check run`, and a report citing the ledger seqs
# maul-tool printed. Every maul-tool command line is appended to
# $HOME/.fake-claude/tools.

# report_path — the report path the prompt names.
# shellcheck disable=SC2016 # the backticks are the prompt's, matched literally
report_path() {
  printf '%s\n' "$prompt" | sed -n 's/.*Write your report to `\([^`]*\)`.*/\1/p' | head -n 1
}

# tool <args> — one maul-tool call: its output in $out, its ledger seq in $seq
# (0 when it printed none). A refusal or a tool error is the tool's answer,
# never the script's failure.
tool() {
  printf '%s\n' "$*" >>"$state/tools"
  out=$(maul-tool "$@" 2>&1) || true
  seq=$(printf '%s\n' "$out" | sed -n 's/^\[maul-tool ledger seq \([0-9]*\)\]$/\1/p' | head -n 1)
  seq=${seq:-0}
}

# green_digest <mode> — the digest of the check maul-tool just printed as
# passing in that mode (dry-run, replay), or nothing.
green_digest() {
  printf '%s\n' "$out" | sed -n "s/^\[observed\] check [^ ]* digest \(sha256:[0-9a-f]*\) $1: pass .*/\1/p" | head -n 1
}

# http_check <id> <outcome> <expect> — an http check of the first component,
# in canonical form (internal/checks.Canonical), so a file's sha256 is its
# digest; <expect> is the expect object's members after the status.
http_check() {
  printf '{"id":"%s","outcome":"%s","form":"http","http":{"target":"%s","steps":[{"request":{"method":"GET","path":"%s"},"expect":{"status":[200]%s}}]}}' \
    "$1" "$2" "$key" "$path" "$3"
}

# browser_check <id> <outcome> — a browser check of the browser entry: the
# element of test id MAUL_FAKE_CLAUDE_BROWSER_TESTID is visible, a square of
# MAUL_FAKE_CLAUDE_BROWSER_SIZE px, and clickable.
browser_check() {
  printf '{"id":"%s","outcome":"%s","form":"browser","browser":{"steps":[{"goto":"%s"},{"expect":{"assert":"visible","locator":{"testid":"%s"}}},{"expect":{"assert":"size","locator":{"testid":"%s"},"width":%s,"height":%s}},{"expect":{"assert":"clickable","locator":{"testid":"%s"}}}]}}' \
    "$1" "$2" "$entry" "$testid" "$testid" "$size" "$size" "$testid"
}

if [ "$MAUL_PHASE" = checkreview ]; then
  out_report=$(report_path)
  answer=${MAUL_FAKE_CLAUDE_REVIEW:-proves}
  printf '%s\n' '---' "answer: $answer" "reason: \"Scripted review from hack/fake-agent/claude: $answer.\"" '---' \
    >"$out_report"
  echo 200 >"$state/sessions/$session"
  emit "$session" 1 300 50 0 40 0.0200 "Reviewed: $answer."
  exit 0
fi

if [ "$MAUL_PHASE" = evaluate ]; then
  if [ "$mode" = resume ]; then
    # A repair: the report is rewritten exactly as the first run wrote it,
    # or, after a capped run, written from what that run found.
    if [ -f "$state/capped-report" ]; then
      mv "$state/capped-report" "$(cat "$state/capped-path")"
    fi
    cost=$(($(cat "$state/sessions/$session" 2>/dev/null || echo 0) + 100))
    echo "$cost" >"$state/sessions/$session"
    emit "$session" 1 10 20 3000 30 "$(printf '0.%04d' "$cost")" "Report kept."
    exit 0
  fi
  out_report=$(report_path)
  ids=$(printf '%s\n' "$prompt" | sed -n '/^### The approved outcomes/,/^### The request/s/^[0-9][0-9]*\. \([a-z][a-z0-9-]*\) (a .*)$/\1/p')
  # shellcheck disable=SC2016 # the backticks are the prompt's, matched literally
  key=$(printf '%s\n' "$prompt" | sed -n 's/^- `\([a-z0-9-]*\)`: served under `.*`$/\1/p' | head -n 1)
  # shellcheck disable=SC2016 # the backticks are the prompt's, matched literally
  path=${MAUL_FAKE_CLAUDE_CHECK_PATH:-$(printf '%s\n' "$prompt" | sed -n 's/^- `[a-z0-9-]*`: served under `\(.*\)`$/\1/p' | head -n 1)}
  text=${MAUL_FAKE_CLAUDE_CHECK_TEXT:-ok}
  entry=${MAUL_FAKE_CLAUDE_BROWSER_ENTRY:-/}
  testid=${MAUL_FAKE_CLAUDE_BROWSER_TESTID:-vote}
  size=${MAUL_FAKE_CLAUDE_BROWSER_SIZE:-32}
  mkdir -p checks
  tool check results
  results=$seq results_out=$out
  verdicts='' proposed='' disputes=''
  for o in $ids; do
    case "${MAUL_FAKE_CLAUDE_EVALUATE:-pass}" in
    pass)
      # The report as the live evaluators write it (S1 bug 5): each verdict
      # names its outcome as outcome, each proposal the file it ran green.
      http_check "$o" "$o" ",\"bodyContains\":\"$text\"" >"checks/$o.json"
      tool check run "checks/$o.json"
      digest=$(green_digest dry-run)
      verdicts="$verdicts
  - outcome: $o
    verdict: pass
    ledger: [$seq]"
      [ -z "$digest" ] || proposed="$proposed
  - id: \"$o\"
    outcome: $o
    file: \"checks/$o.json\""
      ;;
    fail)
      http_check "$o" "$o" ",\"bodyContains\":\"$text\"" >"checks/$o.json"
      tool check run "checks/$o.json"
      run=$seq
      tool logs "$key"
      seq=$run
      verdicts="$verdicts
  - id: $o
    verdict: fail
    ledger: [$seq]
    note: \"The page does not show what the outcome states.\""
      ;;
    red)
      # A check that may show a defect acts on its own run's data: the run
      # token is in its request (review finding 3).
      path="${path%%\?*}?run={{run}}"
      http_check "$o" "$o" ",\"bodyContains\":\"$text\"" >"checks/$o.json"
      tool check run "checks/$o.json"
      run=$seq
      digest=$(green_digest dry-run)
      if [ -n "$digest" ]; then
        verdicts="$verdicts
  - outcome: $o
    verdict: pass
    ledger: [$run]"
        proposed="$proposed
  - id: \"$o\"
    outcome: $o
    file: \"checks/$o.json\""
      elif printf '%s\n' "$out" | grep -q '^\[observed\] red by assertion at step '; then
        tool logs "$key"
        verdicts="$verdicts
  - outcome: $o
    verdict: fail
    ledger: [$run, $seq]
    note: \"The check of the outcome fails at its assertion.\""
        proposed="$proposed
  - id: \"$o\"
    outcome: $o
    file: \"checks/$o.json\"
    expect: fail"
      else
        verdicts="$verdicts
  - outcome: $o
    verdict: unsure
    ledger: [$run]"
      fi
      ;;
    dispute)
      failing=$(printf '%s\n' "$results_out" | sed -n 's/^\[observed\] check [^ ]* digest \(sha256:[0-9a-f]*\) replay: fail.*/\1/p' | head -n 1)
      http_check "$o.r" "$o" ",\"bodyContains\":\"$text\"" >"checks/$o.r.json"
      tool check run "checks/$o.r.json"
      digest=$(green_digest dry-run)
      verdicts="$verdicts
  - id: $o
    verdict: unsure
    note: \"A saved check failed on data it did not create; disputed.\""
      if [ -n "$failing" ] && [ -z "$disputes" ] && [ -n "$digest" ]; then
        disputes="
  - check_digest: \"$failing\"
    reason: \"The check asserts on data it did not create.\"
    replacement: \"$o.r\"
    ledger: [$results]"
        proposed="$proposed
  - id: \"$o.r\"
    outcome: $o
    digest: \"$digest\""
      fi
      ;;
    canary)
      # What the injection asks for: a vacuous check, which maul-tool's dry
      # run refuses (rule 2), proposed anyway by its own digest, and every
      # outcome passed.
      http_check "$o.canary" "$o" '' >"checks/$o.canary.json"
      tool check run "checks/$o.canary.json"
      digest="sha256:$(sha256sum "checks/$o.canary.json" | cut -d ' ' -f 1)"
      verdicts="$verdicts
  - id: $o
    verdict: pass
    ledger: [$results]"
      proposed="$proposed
  - id: \"$o.canary\"
    outcome: $o
    digest: \"$digest\""
      ;;
    browser)
      tool browser goto "$entry"
      tool browser snapshot
      ref=$(printf '%s\n' "$out" | sed -n 's/.* \[ref=\(e[0-9]*\)\].*/\1/p' | sed -n 2p)
      tool browser click "${ref:-e2}"
      tool browser screenshot
      shot=$seq
      browser_check "$o" "$o" >"checks/$o.json"
      tool check run "checks/$o.json"
      digest=$(green_digest dry-run)
      if [ -n "$digest" ]; then
        verdicts="$verdicts
  - id: $o
    verdict: pass
    ledger: [$shot, $seq]"
        proposed="$proposed
  - id: \"$o\"
    outcome: $o
    digest: \"$digest\""
      else
        verdicts="$verdicts
  - id: $o
    verdict: fail
    ledger: [$shot, $seq]
    note: \"The page does not show what the outcome states.\""
      fi
      ;;
    browser-look)
      tool browser goto "$entry"
      tool browser snapshot
      tool browser screenshot
      verdicts="$verdicts
  - id: $o
    verdict: pass
    ledger: [$seq]
    note: \"The screenshot shows what the outcome states.\""
      ;;
    nochecks)
      tool http GET "$path"
      verdicts="$verdicts
  - id: $o
    verdict: pass
    ledger: [$seq]"
      ;;
    esac
  done
  {
    printf '%s' '---' '
verdicts:' "$verdicts"
    if [ -n "$disputes" ]; then printf '\n%s%s' 'disputes:' "$disputes"; else printf '\n%s' 'disputes: []'; fi
    if [ -n "$proposed" ]; then printf '\n%s%s' 'proposed:' "$proposed"; else printf '\n%s' 'proposed: []'; fi
    printf '\n%s' 'retire: []'
    if [ -n "${MAUL_FAKE_CLAUDE_ANOMALY:-}" ]; then
      printf '\n%s\n' 'anomalies:' "  - summary: \"$MAUL_FAKE_CLAUDE_ANOMALY\"" "    route: \"$path\"" \
        "    ledger: [$results]"
    else
      printf '\n%s\n' 'anomalies: []'
    fi
    printf '%s\n' '---' '' "Scripted evaluation (${MAUL_FAKE_CLAUDE_EVALUATE:-pass}) from hack/fake-agent/claude."
  } >"$state/report"
  echo 800 >"$state/sessions/$session"
  if [ -n "${MAUL_FAKE_CLAUDE_CAPPED:-}" ]; then
    mv "$state/report" "$state/capped-report"
    printf '%s' "$out_report" >"$state/capped-path"
    init "$session"
    printf '{"type":"result","subtype":"error_max_turns","is_error":true,"result":"","session_id":"%s","num_turns":%s,"total_cost_usd":0.0800,"usage":{"input_tokens":2000,"cache_creation_input_tokens":300,"cache_read_input_tokens":4000,"output_tokens":600},"errors":["Reached maximum number of turns (%s)"]}\n' \
      "$session" "$turns" "$turns"
    exit 1
  fi
  mv "$state/report" "$out_report"
  emit "$session" 6 2000 300 4000 600 0.0800 "Evaluated: ${MAUL_FAKE_CLAUDE_EVALUATE:-pass}."
  exit 0
fi

if [ "$MAUL_PHASE" = plan ]; then
  repos=$(sed -n '/^## Repositories/,/^## /p' "$workspace/input/issue.md" | sed -n 's/^- \(https:[^ ]*\).*/  - "\1"/p')
  acceptance=''
  case "$prompt" in
  *'### Acceptance criteria'*) acceptance=${MAUL_FAKE_PLAN_ACCEPTANCE:-} ;;
  esac
  mkdir -p "$workspace/reports"
  {
    printf '%s\n' '---' 'summary: "Add a VERSION file (scripted plan from hack/fake-agent/claude)"' 'repositories:'
    [ -z "$repos" ] || printf '%s\n' "$repos"
    printf '%s\n' 'new_dependencies: []' 'questions: []' 'confidence: 0.8' 'estimated_max_turns: 20' \
      'estimated_token_budget: 100000'
    [ -z "$acceptance" ] || printf '%s\n' "$acceptance"
    printf '%s\n' '---' '' '## Approach' '' 'Add a VERSION file at the repository root.' '' '## Steps' '' \
      '1. Create VERSION.' '' '## Test plan' '' '- go test ./...' '' '## Risks' '' 'None.'
  } >"$workspace/reports/plan.md"
  echo 500 >"$state/sessions/$session"
  emit "$session" 2 800 100 2000 300 0.0500 "Planned: add a VERSION file."
  exit 0
fi

if [ "$mode" = first ]; then
  printf '0.1.0\n' >VERSION
  printf '%s\n' '#!/bin/sh' 'set -e' 'git add VERSION' 'git commit -qm "feat: add a VERSION file"' \
    >"$workspace/commit.sh"
  case "${MAUL_FAKE_CLAUDE_REPORT:-ok}" in
  long-note) write_report "notes:
  - \"$(printf '%574s' '' | tr ' ' 'n')\"" ;;
  scalar-notes) write_report 'notes: "What was built: a VERSION file at the repository root"' ;;
  *) write_report 'notes: []' ;;
  esac
  [ "${MAUL_FAKE_CLAUDE_OUTPUT:-0}" -eq 0 ] || run_command "$session" "$MAUL_FAKE_CLAUDE_OUTPUT"
  # Cost in hundredths of a cent, cumulative over the session, as the CLI's.
  echo 1000 >"$state/sessions/$session"
  emit "$session" 3 1000 200 3000 400 0.1000 "Built: VERSION added, the suite passes."
  exit 0
fi

if [ ! -f "$state/sessions/$session" ]; then
  printf '{"type":"result","subtype":"error_during_execution","is_error":true,"num_turns":0,"session_id":"%s","total_cost_usd":0,"usage":{"input_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0,"output_tokens":0},"errors":["No conversation found with session ID: %s"]}\n' \
    "$session" "$session"
  echo "No conversation found with session ID: $session" >&2
  exit 1
fi

case "${MAUL_FAKE_CLAUDE_REPAIR:-fix}" in
fix) write_report 'notes: []' ;;
touch)
  write_report 'notes: []'
  printf '0.2.0\n' >VERSION
  ;;
esac
cost=$(($(cat "$state/sessions/$session") + 100))
echo "$cost" >"$state/sessions/$session"
emit "$session" 1 10 20 3000 30 "$(printf '0.%04d' "$cost")" "Report fixed."
