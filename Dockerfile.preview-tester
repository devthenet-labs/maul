# Preview tester image: cmd/preview-tester, the one-shot Job preview-controller
# runs inside a Preview's slot to observe its approved http acceptance
# criteria. Built by GoReleaser (`dockers_v2` in .goreleaser.yaml), which
# compiles the binary first and hands this file a build context holding only
# it, laid out as $TARGETPLATFORM/preview-tester. No Go toolchain or source
# here; the same buildx invocation produces the linux/amd64 + linux/arm64
# manifest.
#
# A Dockerfile of its own (not Dockerfile.controller) because the tester is
# not a controller: no subcommand, no port, nothing to serve. Its input is the
# literal MAUL_VERIFY_SPEC variable, its output stdout and the termination
# message. distroless static: pure Go, CGO off, no shell, nothing to execute
# but the tester itself.
#
# The chart admits this image into a preview slot only by digest
# (preview.verification.testerImage, stamped at release by
# .github/workflows/helm.yaml); a tag never reaches a slot.
#
# Runs as uid 65532 ("nonroot") under PSA restricted and a read-only root
# filesystem; it writes nothing but /dev/termination-log.

FROM gcr.io/distroless/static-debian13:nonroot@sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7

ARG TARGETPLATFORM

COPY ${TARGETPLATFORM}/preview-tester /usr/local/bin/preview-tester

USER 65532:65532
ENTRYPOINT ["/usr/local/bin/preview-tester"]
