# Preview browser image: the optional browser container of a slot tool pod
# (DESIGN 2.1, 4.2; SPEC S1-07). Its entrypoint is cmd/cdp-shim, the keyed
# CDP shim, run as a native sidecar: it starts one headless Chromium per
# accepted connection over --remote-debugging-pipe and serves CDP only to a
# caller presenting the per-evaluation key and no Origin header. Chromium
# never opens a TCP debugging port.
#
# Chromium runs with --no-sandbox (SP-3: RuntimeDefault seccomp refuses its
# namespace sandbox); the container holds nothing but the key's file, which
# only the shim reads. The shim runs Chromium's real binary, not wolfi's
# /usr/bin/chromium wrapper, which would add flags from the environment and
# /etc/chromium. The setuid sandbox helper and chromedriver are removed.
#
# Built by GoReleaser (`dockers_v2` id preview-browser in .goreleaser.yaml),
# which compiles cdp-shim first and hands this file a build context holding
# only it, laid out as $TARGETPLATFORM/cdp-shim; one buildx invocation
# produces the linux/amd64 + linux/arm64 manifest. The chart admits this
# image into a preview slot only by digest.

# The same pinned wolfi-base as the agent images. The digest pins the base
# (renovate bumps it); Chromium is pinned to its exact version in wolfi's
# index, which keeps old versions, so the build stays reproducible. No
# renovate datasource serves wolfi's apk versions (repology does not track
# wolfi), so a Chromium bump is by hand, like the toolbox's apk pins: list
# the index's versions with `apk search -x chromium` in the base, and run
# TestLiveCDPShim (`mise run live-browser`) inside the new image before it
# merges.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:1d95114038f76513a9ace6fca107d5582b08c65981f81f61cb56bf7fd2ef216d

ARG TARGETPLATFORM

ARG CHROMIUM_VERSION=149.0.7827.53-r0

RUN apk add --no-cache "chromium=${CHROMIUM_VERSION}" \
  && rm -f /usr/lib/chromium/chrome_sandbox /usr/lib/chromium/chromedriver \
  && test -x /usr/lib/chromium/chrome

COPY ${TARGETPLATFORM}/cdp-shim /usr/local/bin/cdp-shim

# Everything writable is under /tmp, an emptyDir in the pod: the browser
# profiles (one per connection, removed when its browser exits), fontconfig's
# cache and Chromium's crash-handler database.
ENV HOME=/tmp \
    TMPDIR=/tmp \
    XDG_CONFIG_HOME=/tmp/.config \
    XDG_CACHE_HOME=/tmp/.cache \
    LANG=C.UTF-8

LABEL org.opencontainers.image.title="maul preview-browser" \
      org.opencontainers.image.description="The browser container of a maul slot tool pod: headless Chromium behind the keyed cdp-shim." \
      org.opencontainers.image.source="https://github.com/devthenet-labs/maul" \
      org.opencontainers.image.licenses="MIT"

# Runs as uid 65532 under PSA restricted and a read-only root filesystem.
# The pod passes --key-file (and --addr when not loopback).
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/cdp-shim", "--chromium=/usr/lib/chromium/chrome"]
