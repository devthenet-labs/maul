  {
    "id": "tempo-loaded-beat-page",
    "body": "{\"id\":\"tempo-loaded-beat-page\",\"outcome\":\"tempo-loaded-beat\",\"form\":\"browser\",\"browser\":{\"steps\":[{\"goto\":\"/\"},{\"fill\":{\"locator\":{\"label\":\"Author\"},\"text\":\"{{run}}-dj\"}},{\"fill\":{\"locator\":{\"label\":\"Beat name\"},\"text\":\"{{run}}-slow\"}},{\"fill\":{\"locator\":{\"css\":\"#bpm\"},\"text\":\"75\"}},{\"click\":{\"role\":\"button\",\"name\":\"Save\"}},{\"expect\":{\"assert\":\"text\",\"locator\":{\"css\":\"#fresh li\",\"hasText\":\"{{run}}-slow\"},\"text\":{\"contains\":\"75 bpm\"}}},{\"fill\":{\"locator\":{\"label\":\"Beat name\"},\"text\":\"{{run}}-fast\"}},{\"fill\":{\"locator\":{\"css\":\"#bpm\"},\"text\":\"150\"}},{\"click\":{\"role\":\"button\",\"name\":\"Save\"}},{\"expect\":{\"assert\":\"text\",\"locator\":{\"css\":\"#fresh li\",\"hasText\":\"{{run}}-fast\"},\"text\":{\"contains\":\"150 bpm\"}}},{\"goto\":\"/\"},{\"expect\":{\"assert\":\"text\",\"locator\":{\"css\":\"#tempo-out\"},\"text\":{\"equals\":\"medium\"}}},{\"click\":{\"css\":\"button.load\",\"within\":{\"css\":\"#fresh li\",\"hasText\":\"{{run}}-slow\"}}},{\"expect\":{\"assert\":\"text\",\"locator\":{\"css\":\"#bpm-out\"},\"text\":{\"equals\":\"75\"}}},{\"expect\":{\"assert\":\"text\",\"locator\":{\"css\":\"#tempo-out\"},\"text\":{\"equals\":\"slow\"}}},{\"click\":{\"css\":\"button.load\",\"within\":{\"css\":\"#fresh li\",\"hasText\":\"{{run}}-fast\"}}},{\"expect\":{\"assert\":\"text\",\"locator\":{\"css\":\"#bpm-out\"},\"text\":{\"equals\":\"150\"}}},{\"expect\":{\"assert\":\"text\",\"locator\":{\"css\":\"#tempo-out\"},\"text\":{\"equals\":\"fast\"}}},{\"fill\":{\"locator\":{\"css\":\"#bpm\"},\"text\":\"110\"}},{\"expect\":{\"assert\":\"text\",\"locator\":{\"css\":\"#tempo-out\"},\"text\":{\"equals\":\"medium\"}}},{\"click\":{\"css\":\"button.load\",\"within\":{\"css\":\"#fresh li\",\"hasText\":\"{{run}}-slow\"}}},{\"expect\":{\"assert\":\"text\",\"locator\":{\"css\":\"#bpm-out\"},\"text\":{\"equals\":\"75\"}}},{\"expect\":{\"assert\":\"text\",\"locator\":{\"css\":\"#tempo-out\"},\"text\":{\"equals\":\"slow\"}}}]}}",
