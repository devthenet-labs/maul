# Preview toolbox image: the sandbox container of a slot tool pod (DESIGN
# 2.1, 4.2; SPEC S1-08), the one container of the pod where agent-written
# programs run. Its entrypoint is cmd/tool-exec, the exec shim the tools
# container drives over a unix socket in a shared emptyDir
# (/run/maul-exec/sock); programs run as this container's own UID in
# /work/scratch, at most 60 s and 64 KiB of output each.
#
# The toolbox is what an evaluator's client program may use against a
# preview: curl, grpcurl, websocat, node, python and go, each pinned. It holds
# nothing secret and no network of its own beyond the pod's. There is no
# package index or module proxy to reach, so programs use the standard
# libraries (GOPROXY=off, no pip or npm cache).
#
# Built by GoReleaser (`dockers_v2` id preview-toolbox in .goreleaser.yaml),
# which compiles tool-exec first and hands this file a build context holding
# only it, laid out as $TARGETPLATFORM/tool-exec; one buildx invocation
# produces the linux/amd64 + linux/arm64 manifest. The chart admits this image
# into a preview slot only by digest.

# The same pinned wolfi-base as the agent images. The digest pins the base;
# each package below is pinned to its exact version in that index, and
# websocat, which wolfi does not package, to its release's sha256 per
# architecture.
FROM cgr.dev/chainguard/wolfi-base:latest@sha256:1d95114038f76513a9ace6fca107d5582b08c65981f81f61cb56bf7fd2ef216d

ARG TARGETPLATFORM
ARG TARGETARCH

ARG WEBSOCAT_VERSION=1.14.1
ARG WEBSOCAT_SHA256_AMD64=66f8dd3a0394761556339117f8bb5123bddefd44e087af2a72ec22b0bd08d514
ARG WEBSOCAT_SHA256_ARM64=711a69576a2ff473fb01a90ffafb571c2ed019e55479d7ae71b12c2eadeb7011

RUN apk add --no-cache \
      curl=8.23.0-r2 \
      grpcurl=1.9.4-r6 \
      nodejs-24=24.22.1-r2 \
      python-3.13=3.13.17_git20261023-r1 \
      go-1.26=1.26.10-r0 \
  && case "${TARGETARCH}" in \
       amd64) arch=x86_64; sum="${WEBSOCAT_SHA256_AMD64}" ;; \
       arm64) arch=aarch64; sum="${WEBSOCAT_SHA256_ARM64}" ;; \
       *) echo "no websocat for ${TARGETARCH}" >&2; exit 1 ;; \
     esac \
  && install -d -m 0755 /usr/local/bin \
  && curl -fsSL -o /usr/local/bin/websocat \
       "https://github.com/vi/websocat/releases/download/v${WEBSOCAT_VERSION}/websocat.${arch}-unknown-linux-musl" \
  && printf '%s  /usr/local/bin/websocat\n' "${sum}" > /tmp/websocat.sha256 \
  && sha256sum -c /tmp/websocat.sha256 \
  && rm /tmp/websocat.sha256 \
  && chmod 0755 /usr/local/bin/websocat \
  && install -d -o 65534 -g 65534 -m 0700 /work /work/scratch \
  && install -d -o 65534 -g 65534 -m 0755 /run/maul-exec

COPY ${TARGETPLATFORM}/tool-exec /usr/local/bin/tool-exec

# What tool-exec passes on to programs (cmd/tool-exec passEnv); everything
# writable is under /tmp, an emptyDir in the pod.
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    TMPDIR=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    GOPATH=/tmp/go \
    GOTOOLCHAIN=local \
    GOPROXY=off \
    GOSUMDB=off \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

LABEL org.opencontainers.image.title="maul preview-toolbox" \
      org.opencontainers.image.description="The sandbox container of a maul slot tool pod: the tool-exec shim with curl, grpcurl, websocat, node, python and go." \
      org.opencontainers.image.source="https://github.com/devthenet-labs/maul" \
      org.opencontainers.image.licenses="MIT"

WORKDIR /work/scratch

# Runs as uid 65534, the sandbox UID preview-controller sets (toolpod.go
# sandboxUID), under PSA restricted and a read-only root filesystem.
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/tool-exec"]
