// Extends the org preset every repository inherits through the bot's global config
// (github>bitwise-media-group/renovate-config:default.json5); only what is added here is maul's own.
{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    customManagers: [
        // The upstream charts `maul setup previews` writes values for, and the images its manifests run
        // (design §5.3): each version a Go constant under a `// renovate:` comment, an image's as
        // <tag>@<digest>. TestRenovateTracksPins holds this manager to pins.go, and CI's preview-pins job
        // checks a bumped pin against its chart, its CRDs and its image.
        {
            customType: "regex",
            description: "setup previews chart pins",
            managerFilePatterns: ["/^cmd/maul/internal/previewsetup/pins\\.go$/"],
            matchStrings: [
                '// renovate: datasource=(?<datasource>\\S+) registryUrl=(?<registryUrl>\\S+) depName=(?<depName>\\S+)\\nconst \\w+ = "(?<currentValue>[^"]+)"',
                '// renovate: datasource=(?<datasource>docker) depName=(?<depName>\\S+)\\nconst \\w+ = "(?<currentValue>[^"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})"',
            ],
        },
    ],
    packageRules: [
        // The preview-tools image's Node project (internal/previewtools/node, Dockerfile.preview-tools): every
        // version pinned exactly, and the Playwright CLI moved together with both playwright-core trees it
        // installs (its own alpha and @playwright/test's release), so the snapshot and ref grammar the browser
        // relay parses is re-checked as one change: CI's browser-tools job runs TestPlaywrightCLIFormat on the
        // bump, and a changed grammar fails until the relay handles it.
        {
            matchFileNames: ["internal/previewtools/node/package.json"],
            rangeStrategy: "pin",
        },
        {
            matchFileNames: ["internal/previewtools/node/package.json"],
            matchPackageNames: ["@playwright/cli", "@playwright/test", "playwright", "playwright-core"],
            groupName: "playwright (preview-tools)",
        },
    ],
}
