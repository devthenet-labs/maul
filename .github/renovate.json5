// Extends the org preset every repository inherits through the bot's global config
// (github>bitwise-media-group/renovate-config:default.json5); only what is added here is patchy's own.
{
    $schema: "https://docs.renovatebot.com/renovate-schema.json",
    customManagers: [
        // The upstream charts `patchy setup previews` writes values for (design §5.3): each version a Go
        // constant under a `// renovate:` comment. TestRenovateTracksPins holds this manager to pins.go,
        // and CI's preview-pins job checks a bumped pin against its chart and CRDs.
        {
            customType: "regex",
            description: "setup previews chart pins",
            managerFilePatterns: ["/^cmd/patchy/internal/previewsetup/pins\\.go$/"],
            matchStrings: [
                '// renovate: datasource=(?<datasource>\\S+) registryUrl=(?<registryUrl>\\S+) depName=(?<depName>\\S+)\\nconst \\w+ = "(?<currentValue>[^"]+)"',
            ],
        },
    ],
}
