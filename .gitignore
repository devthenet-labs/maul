# build artifacts (a bare `go build ./cmd/<binary>` at the root writes one
# of these; `mise run build` writes to /bin/)
/bin/
dist/
/agent-runner
/context-controller
/egress-broker
/egress-proxy
/evaluation-controller
/integration-controller
/intent-controller
/investigation-controller
/kubectl-patchy
/patchy
/preview-auth
/preview-controller
/remediation-controller
/source-controller
/status-server

# docs site (zensical) build output + python env
/site/
/.cache/
/.venv/

# coverage (make test)
coverage/

# claude code
/.claude/**
!/.claude/settings.json

# node modules
node_modules/

# terraform working state (deploy/terraform is a module: no lock file is kept,
# callers pin providers in their own roots)
.terraform/
.terraform.lock.hcl
