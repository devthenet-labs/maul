{
  "name": "maul-acme",
  "url": "https://github.com/devthenet-labs/maul",
  "description": "maul: security findings, intents, check-fix rounds, failed-check re-runs",
  "hook_attributes": {
    "url": "https://maul.acme.test/github/webhooks",
    "active": true
  },
  "redirect_url": "http://127.0.0.1:49152/callback",
  "public": false,
  "default_permissions": {
    "actions": "write",
    "checks": "read",
    "contents": "write",
    "issues": "write",
    "metadata": "read",
    "pull_requests": "write",
    "security_events": "write",
    "statuses": "write"
  },
  "default_events": [
    "code_scanning_alert",
    "issue_comment",
    "issues",
    "pull_request"
  ]
}
